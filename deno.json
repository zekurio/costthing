{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true
  },
  "imports": {
    "@fontsource-variable/google-sans": "npm:@fontsource-variable/google-sans@^5.3.0",
    "@tsconfig/svelte": "npm:@tsconfig/svelte@5.0.8",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@6.2.4",
    "elysia": "npm:elysia@1.4.29",
    "lucide-svelte": "npm:lucide-svelte@^1.0.1",
    "svelte": "npm:svelte@5.56.4",
    "svelte-check": "npm:svelte-check@4.7.2",
    "typescript": "npm:typescript@5.9.3",
    "vite": "npm:vite@7.3.6"
  },
  "tasks": {
    "check": "deno check src/ shared/ && deno task frontend:check",
    "start": "deno run --allow-env --allow-net --allow-read --allow-write src/main.ts",
    "dev": {
      "dependencies": ["backend:dev", "frontend:dev"]
    },
    "backend:dev": "deno run --env-file=.env --watch --allow-env --allow-net --allow-read --allow-write src/main.ts",
    "frontend:dev": "deno run -A vite frontend",
    "frontend:check": "deno run -A svelte-check --tsconfig frontend/tsconfig.json",
    "frontend:build": "deno run -A vite build frontend"
  },
  "fmt": {
    "singleQuote": true,
    "semiColons": false,
    "lineWidth": 100,
    "exclude": ["frontend"]
  },
  "lint": {
    "rules": {
      "exclude": ["require-await"]
    },
    "exclude": ["frontend"]
  },
  "nodeModulesDir": "auto"
}
